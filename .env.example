# Edge Terminal Identification
STORE_ID=ST-0991
TERMINAL_ID=POS-REG-01
TERMINAL_TOKEN=test-edge-token-0991

# Networking & Ports
HOST=127.0.0.1
PORT=8000
METRICS_PORT=9090

# Hardware Telemetry & Thresholds
VRAM_TOTAL_MB=4096
KAN_DECISION_THRESHOLD=0.50
MAX_INFERENCE_THREADS=2
DEVICE_ID=0

# Model & Database Storage Paths
KAN_MODEL_PATH=models/kan_gate_weights.pt
ONNX_MODEL_PATH=models/footfall_quant_int8.onnx
SQLITE_DB_PATH=data/edge_analytics.db

# Elastic Cloud Fallback Configuration
CLOUD_FALLBACK_URL=https://cloud-gpu.pos-analytics.internal/api/v1/infer
CLOUD_FALLBACK_TIMEOUT_MS=2000
CLOUD_API_KEY=mock-cloud-gpu-key-prod-01

# Cloud Sync Daemon
CLOUD_SYNC_ENABLED=true
CLOUD_SYNC_INTERVAL_SEC=60
CENTRAL_POSTGRES_INGEST_URL=https://cloud-gpu.pos-analytics.internal/api/v1/telemetry/sync

